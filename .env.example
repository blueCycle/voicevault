# VoiceVault Configuration

# Data paths
# Default (if unset) is ~/Library/Application Support/VoiceVault — the
# standard place a macOS app keeps its user data. Uncomment to override.
# VV_DATA_DIR=~/Library/Application Support/VoiceVault
VV_OBSIDIAN_VAULT=~/Obsidian/voicevault

# Whisper settings
# mlx-whisper requires Apple Silicon (M-series). On Intel Macs, switch to
# VV_WHISPER_BACKEND=faster-whisper and VV_WHISPER_DEVICE=cpu instead.
VV_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
VV_WHISPER_BACKEND=mlx-whisper
VV_WHISPER_DEVICE=mps

# Dictation hotkey (hold this key to speak, release to stop).
# fn, ctrl, cmd, alt, f13-f20, or any single letter. Defaults to fn so it
# matches Wispr Flow's own hotkey — whichever app is actually running
# owns the key, no need to remap either one.
VV_DICTATE_HOTKEY=fn

# Legacy aliases (still supported)
# VV_WISPR_HOTKEY=fn

# Default providers (fallback chain)
VV_STT_PROVIDER=local
VV_LLM_PROVIDER=ollama
VV_JUDGE_PROVIDER=anthropic

# Ollama (for meeting summaries)
VV_OLLAMA_URL=http://localhost:11434
VV_OLLAMA_MODEL=llama3.1:8b

# Cloud STT Providers (optional - auto-detected if keys present)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=
REVAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloud LLM Providers (optional - auto-detected if keys present)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
