# VoiceVault Configuration

# Data paths
VV_DATA_DIR=~/code/experiments/voicevault/data
VV_OBSIDIAN_VAULT=~/Obsidian/amit-voicevault

# Whisper settings
VV_WHISPER_MODEL=base
VV_WHISPER_BACKEND=faster-whisper
VV_WHISPER_DEVICE=cpu

# Dictation hotkey (hold this key to speak, release to stop)
VV_DICTATE_HOTKEY=ctrl

# Legacy aliases (still supported)
# VV_WISPR_HOTKEY=ctrl

# Default providers (fallback chain)
VV_STT_PROVIDER=local
VV_LLM_PROVIDER=ollama
VV_JUDGE_PROVIDER=anthropic

# Ollama (for meeting summaries)
VV_OLLAMA_URL=http://localhost:11434
VV_OLLAMA_MODEL=llama3.1:8b

# Cloud STT Providers (optional - auto-detected if keys present)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=
REVAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloud LLM Providers (optional - auto-detected if keys present)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
